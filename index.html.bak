<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#10151c"><meta name="description" content="أثر — إدارة حجوزات استوديو الإنتاج الفني والتسجيل الصوتي"><link rel="manifest" href="manifest.webmanifest"><link rel="apple-touch-icon" href="icon-192.png"><title>أثر | الإنتاج الفني</title>
<style>
:root{--site-primary:#171a20;--site-secondary:#d7aa55;--site-background:#f4f2ed}
.splash{position:fixed;inset:0;z-index:100;background:#0d1118 url("cover.webp") center/cover no-repeat;display:flex;align-items:flex-end;justify-content:center;padding:28px 20px max(28px,env(safe-area-inset-bottom));transition:opacity .45s ease,visibility .45s ease}
.splash::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(6,10,15,.05) 25%,rgba(6,10,15,.25) 52%,rgba(6,10,15,.94) 100%)}
.splash-inner{position:relative;z-index:1;text-align:center;width:min(100%,420px);color:#fff}
.splash-title{font-size:30px;font-weight:900;letter-spacing:.4px;color:#f0c979;margin:0 0 8px;text-shadow:0 2px 18px #000}
.splash-sub{font-size:14px;line-height:1.9;color:#f5e9d2;margin:0 auto 20px;max-width:330px}
.splash-btn{border:1px solid #f2d28b;background:linear-gradient(135deg,#e6c078,#b78335);color:#17130d;border-radius:14px;padding:14px 24px;font-weight:900;font-size:15px;width:min(100%,310px);box-shadow:0 10px 30px #0005}
.splash.hide{opacity:0;visibility:hidden;pointer-events:none}
.install-btn{border:1px solid #b98d48;background:transparent;color:inherit;border-radius:10px;padding:9px 12px;font-weight:700}

:root{--site-primary:#173f35;--site-secondary:#d7b36a;--site-background:#f4f2ed;--site-on-primary:#ffffff;--site-on-secondary:#17231e;--site-on-background:#1f2925;--site-font-body:Tahoma,Arial,sans-serif;--site-font-heading:Tahoma,Arial,sans-serif;--site-heading-scale:1;--site-spacing-scale:1;--site-radius-scale:1;--site-decoration-opacity:1;--ink:#1f2925;--muted:#77817b;--line:#e6e4dd;--surface:#fffefa;--green:#1d6a4e;--red:#a7443b;--amber:#9a6c1c}
*{box-sizing:border-box}body{margin:0;background:var(--site-background);color:var(--ink);font-family:var(--site-font-body);font-size:14px}button,input,select,textarea{font:inherit}button{cursor:pointer}.app{min-height:100vh;background:var(--site-background);color:var(--site-on-background);border-radius:0}.topbar{background:var(--site-primary);color:#fff;padding:18px clamp(16px,4vw,42px);display:flex;align-items:center;justify-content:space-between;gap:16px}.brand{display:flex;align-items:center;gap:12px}.brandmark{height:44px;width:44px;border-radius:14px;background:var(--site-secondary);color:#173f35;display:grid;place-items:center;font-size:23px;font-weight:bold}.brand h1{font-size:20px;margin:0 0 4px}.brand p{font-size:12px;margin:0;color:#d7e3dc}.topmeta{font-size:12px;color:#e5eee8;text-align:left}.wrap{max-width:1240px;margin:auto;padding:26px clamp(14px,3vw,34px) 40px}.heading{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:22px}.heading h2{margin:0 0 7px;font-size:calc(27px * var(--site-heading-scale))}.heading p{margin:0;color:var(--muted);line-height:1.7}.btn{border:0;border-radius:calc(11px * var(--site-radius-scale));padding:12px 16px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;gap:8px;transition:.15s}.btn-primary{background:var(--site-primary);color:#fff}.btn-primary:hover{filter:brightness(1.12)}.btn-light{background:#e9eee9;color:var(--site-primary)}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:22px}.stat{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:18px;min-width:0}.stat-top{display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-size:12px;gap:8px}.stat-icon{width:34px;height:34px;border-radius:11px;background:#eaf0e9;color:var(--site-primary);display:grid;place-items:center;font-size:17px}.stat strong{display:block;font-size:27px;margin:14px 0 4px;letter-spacing:-.5px}.stat small{color:var(--muted);font-size:11px}.layout{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:18px;align-items:start}.panel{background:var(--surface);border:1px solid var(--line);border-radius:18px;overflow:hidden}.panel-head{padding:18px 20px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px}.panel-head h3{margin:0;font-size:16px}.panel-head span{color:var(--muted);font-size:12px}.filters{padding:14px 18px;display:flex;gap:10px;flex-wrap:wrap;border-bottom:1px solid var(--line)}.field{display:flex;flex-direction:column;gap:7px;min-width:0}.filters .field{flex:1;min-width:130px}.field label{font-size:12px;color:#5d6962;font-weight:700}.field input,.field select,.field textarea{width:100%;border:1px solid #dcded7;border-radius:10px;padding:11px 12px;background:#fffefa;color:var(--ink);outline:none}.field input:focus,.field select:focus,.field textarea:focus{border-color:#628b77;box-shadow:0 0 0 3px #e7efe9}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;white-space:nowrap}th,td{padding:14px 16px;text-align:right;border-bottom:1px solid #efeee9}th{font-size:11px;color:var(--muted);font-weight:700;background:#fbfaf6}td{font-size:12px}tbody tr:hover{background:#faf9f4}.client{font-weight:700;font-size:13px}.sub{font-size:11px;color:var(--muted);margin-top:5px}.pill{display:inline-flex;align-items:center;gap:5px;padding:6px 9px;border-radius:30px;font-size:11px;font-weight:700}.pill.confirmed{background:#e3f2e9;color:#276c4d}.pill.pending{background:#fff0d4;color:#91671c}.pill.done{background:#e9eaf7;color:#4f548d}.pill.cancelled{background:#f8e5e2;color:#a7443b}.row-actions{display:flex;gap:5px}.icon-btn{width:30px;height:30px;border:1px solid var(--line);background:#fffefa;border-radius:8px;color:#52635a}.icon-btn:hover{background:#eaf0e9}.empty{text-align:center;padding:38px 15px;color:var(--muted)}.side{display:flex;flex-direction:column;gap:18px}.form-panel{padding:19px}.form-panel h3{margin:0 0 5px;font-size:17px}.form-panel .intro{margin:0 0 18px;color:var(--muted);font-size:12px;line-height:1.6}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.span2{grid-column:1/-1}.form-actions{display:flex;gap:9px;margin-top:17px}.form-actions button{flex:1}.money-preview{display:flex;justify-content:space-between;gap:8px;padding:12px;border-radius:11px;background:#f1f4ef;font-size:12px}.money-preview strong{color:var(--site-primary)}.quick-list{padding:18px}.quick-list h3{margin:0 0 14px;font-size:15px}.quick-item{display:flex;align-items:center;gap:11px;padding:11px 0;border-bottom:1px solid var(--line)}.quick-item:last-child{border-bottom:0}.datebox{width:44px;height:47px;border-radius:10px;background:#eef2eb;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--site-primary);flex-shrink:0}.datebox b{font-size:17px}.datebox small{font-size:10px}.quick-info{min-width:0;flex:1}.quick-info strong{display:block;font-size:12px;overflow:hidden;text-overflow:ellipsis}.quick-info span{display:block;font-size:11px;color:var(--muted);margin-top:4px}.note{margin-top:17px;color:var(--muted);font-size:11px;line-height:1.8}.toast{position:fixed;bottom:22px;left:50%;transform:translate(-50%,20px);opacity:0;pointer-events:none;background:#193e33;color:#fff;padding:12px 18px;border-radius:12px;box-shadow:0 10px 30px #0002;transition:.25s;z-index:5}.toast.show{opacity:1;transform:translate(-50%,0)}.modal-backdrop{position:fixed;inset:0;background:#101a16a6;display:none;align-items:center;justify-content:center;padding:18px;z-index:10}.modal-backdrop.show{display:flex}.modal{background:var(--surface);border-radius:18px;max-width:520px;width:100%;padding:22px;max-height:90vh;overflow:auto}.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.modal-head h3{margin:0}.close{border:0;background:#eef0eb;border-radius:9px;width:34px;height:34px;font-size:18px}.danger{color:var(--red)}footer{text-align:center;color:var(--muted);font-size:11px;padding:22px 0 0}.mobile-label{display:none}
@media(max-width:950px){.layout{grid-template-columns:1fr}.side{display:grid;grid-template-columns:1fr 1fr}.stats{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:620px){.topbar{padding:14px}.topmeta{display:none}.wrap{padding:20px 12px 30px}.heading{align-items:stretch;flex-direction:column}.heading h2{font-size:24px}.heading .btn{width:100%}.stats{gap:9px}.stat{padding:13px}.stat strong{font-size:23px}.stat-top{font-size:11px}.layout{gap:13px}.side{display:flex}.panel-head{padding:15px}.filters{padding:12px}.filters .field{min-width:100%}.form-grid{grid-template-columns:1fr}.span2{grid-column:auto}.form-panel{padding:16px}.table-wrap table{min-width:750px}.mobile-label{display:inline}.panel-head span{display:none}}
</style></head>
<body><section class="splash" id="splash" aria-label="واجهة أثر"><div class="splash-inner"><h1 class="splash-title">أَثَر</h1><p class="splash-sub">إدارة حجوزات الاستوديو<br>للإنتاج الفني وتسجيل الإنشاد الديني</p><button class="splash-btn" id="enterApp">دخول إلى إدارة الاستوديو　 ←</button><p style="font-size:11px;color:#e4d4b5;margin:15px 0 0">صوتٌ يُصنع بإتقان</p></div></section><main class="app" id="app">
<header class="topbar"><div class="brand"><div class="brandmark">أ</div><div><h1>أثر | ATHAR</h1><p>إدارة حجوزات استوديو الإنتاج الفني</p></div></div><div class="topmeta" id="todayLabel"></div></header>
<div class="wrap"><section class="heading"><div><h2>إدارة الاستوديو</h2><p>كل جلسات التسجيل في مكان واحد — نظّم مواعيدك وتابع حساباتك بسهولة.</p></div><button class="btn btn-primary" id="newBookingBtn">＋ حجز جديد</button></section>
<section class="stats">
<div class="stat"><div class="stat-top"><span>حجوزات اليوم</span><span class="stat-icon">▦</span></div><strong id="todayCount">0</strong><small>كل جلسات اليوم</small></div>
<div class="stat"><div class="stat-top"><span>حجوزات قادمة</span><span class="stat-icon">◷</span></div><strong id="upcomingCount">0</strong><small>حجوزات مؤكدة أو قيد التأكيد</small></div>
<div class="stat"><div class="stat-top"><span>إجمالي الإيرادات المتوقعة</span><span class="stat-icon">ج</span></div><strong id="revenueTotal">0 ج.م</strong><small>للحجوزات غير الملغاة</small></div>
<div class="stat"><div class="stat-top"><span>مبالغ متبقية</span><span class="stat-icon">◈</span></div><strong id="remainingTotal">0 ج.م</strong><small>تُحصّل من العملاء</small></div>
</section>
<div class="layout"><section class="panel"><div class="panel-head"><h3>سجل الحجوزات</h3><span id="bookingCount">0 حجز</span></div>
<div class="filters"><div class="field"><label for="searchInput">بحث باسم العميل أو الهاتف</label><input id="searchInput" placeholder="اكتب اسم العميل أو رقمه..."></div><div class="field"><label for="statusFilter">حالة الحجز</label><select id="statusFilter"><option value="all">كل الحالات</option><option value="pending">قيد التأكيد</option><option value="confirmed">مؤكد</option><option value="done">تم التسجيل</option><option value="cancelled">ملغي</option></select></div><div class="field"><label for="dateFilter">التاريخ</label><input type="date" id="dateFilter"></div></div>
<div class="table-wrap"><table><thead><tr><th>العميل</th><th>موعد الجلسة</th><th>الخدمة</th><th>الإجمالي</th><th>الحالة</th><th>إجراءات</th></tr></thead><tbody id="bookingsBody"></tbody></table><div class="empty" id="emptyState" hidden>مفيش حجوزات مطابقة للبحث.<br>ابدأ بإضافة حجز جديد من النموذج.</div></div></section>
<aside class="side"><section class="panel form-panel" id="bookingFormPanel"><h3 id="formTitle">إضافة حجز جديد</h3><p class="intro">سجّل بيانات العميل وموعد الجلسة والتكلفة.</p>
<form id="bookingForm"><input type="hidden" id="bookingId"><div class="form-grid">
<div class="field span2"><label for="clientName">اسم العميل *</label><input id="clientName" required placeholder="الاسم بالكامل"></div>
<div class="field span2"><label for="clientPhone">رقم الهاتف *</label><input id="clientPhone" required inputmode="tel" placeholder="01xxxxxxxxx"></div>
<div class="field"><label for="bookingDate">تاريخ الحجز *</label><input type="date" id="bookingDate" required></div><div class="field"><label for="bookingTime">وقت البداية *</label><input type="time" id="bookingTime" required value="17:00"></div>
<div class="field span2"><label for="serviceType">نوع الخدمة *</label><select id="serviceType" required><option value="تسجيل إنشاد ديني">تسجيل إنشاد ديني</option><option value="تسجيل صوتي">تسجيل صوتي</option><option value="مكساج وماستر">مكساج وماستر</option><option value="تسجيل إعلان">تسجيل إعلان</option><option value="إنتاج فني كامل">إنتاج فني كامل</option><option value="أخرى">أخرى</option></select></div>
<div class="field"><label for="sessionDuration">مدة الجلسة</label><select id="sessionDuration"><option>ساعة</option><option>ساعتان</option><option>3 ساعات</option><option>4 ساعات</option><option>يوم كامل</option></select></div><div class="field"><label for="bookingStatus">حالة الحجز</label><select id="bookingStatus"><option value="pending">قيد التأكيد</option><option value="confirmed">مؤكد</option><option value="done">تم التسجيل</option><option value="cancelled">ملغي</option></select></div>
<div class="field"><label for="totalPrice">السعر الإجمالي (ج.م) *</label><input id="totalPrice" type="number" min="0" step="1" required placeholder="0"></div><div class="field"><label for="deposit">العربون المدفوع (ج.م)</label><input id="deposit" type="number" min="0" step="1" value="0"></div>
<div class="span2 money-preview"><span>المبلغ المتبقي</span><strong id="remainingPreview">0 ج.م</strong></div>
<div class="field span2"><label for="bookingNotes">ملاحظات (اختياري)</label><textarea id="bookingNotes" rows="2" placeholder="اسم العمل، المقام المطلوب، ملاحظات فنية..."></textarea></div>
</div><div class="form-actions"><button class="btn btn-primary" type="submit" id="saveBookingBtn">حفظ الحجز</button><button class="btn btn-light" type="button" id="resetFormBtn">تفريغ</button></div></form>
<p class="note">ملاحظة: دي نسخة تجريبية تحفظ البيانات على نفس المتصفح والجهاز. البيانات مش بتتزامن تلقائيًا بين الأجهزة.</p></section>
<section class="panel quick-list"><h3>أقرب المواعيد</h3><div id="upcomingList"></div></section></aside></div>
<footer>أثر — إدارة حجوزات الإنتاج الفني والتسجيل الصوتي</footer></div></main>
<div class="toast" id="toast"></div>
<div class="modal-backdrop" id="detailModal"><div class="modal"><div class="modal-head"><h3>تفاصيل الحجز</h3><button class="close" id="closeModal" aria-label="إغلاق">×</button></div><div id="modalContent"></div></div></div>
<script>
const $=id=>document.getElementById(id);const STORE='asraa_studio_bookings_v1';let bookings=[];let toastTimer;
const labels={pending:'قيد التأكيد',confirmed:'مؤكد',done:'تم التسجيل',cancelled:'ملغي'};
const money=n=>new Intl.NumberFormat('ar-EG',{maximumFractionDigits:0}).format(Number(n)||0)+' ج.م';
const pad=n=>String(n).padStart(2,'0');const todayISO=()=>{const d=new Date();return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`};
function safe(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function load(){try{bookings=JSON.parse(localStorage.getItem(STORE)||'[]');if(!Array.isArray(bookings))bookings=[]}catch{bookings=[]}}
function persist(){try{localStorage.setItem(STORE,JSON.stringify(bookings))}catch{showToast('تعذر حفظ البيانات في هذا المتصفح.')}}
function showToast(msg){const t=$('toast');t.textContent=msg;t.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),2600)}
function dateLabel(s){if(!s)return '—';const d=new Date(s+'T12:00:00');return new Intl.DateTimeFormat('ar-EG',{day:'numeric',month:'short',year:'numeric'}).format(d)}
function timeLabel(s){if(!s)return '—';let [h,m]=s.split(':').map(Number);const ap=h>=12?'م':'ص';h=h%12||12;return `${h}:${pad(m)} ${ap}`}
function remaining(b){return Math.max(0,(Number(b.total)||0)-(Number(b.deposit)||0))}
function render(){const q=$('searchInput').value.trim().toLowerCase(),status=$('statusFilter').value,date=$('dateFilter').value;const filtered=bookings.filter(b=>(!q||(`${b.name} ${b.phone}`.toLowerCase().includes(q))&&(status==='all'||b.status===status)&&(!date||b.date===date))).sort((a,b)=>(a.date+a.time).localeCompare(b.date+b.time));
$('bookingsBody').innerHTML=filtered.map(b=>`<tr><td><div class="client">${safe(b.name)}</div><div class="sub">${safe(b.phone)}</div></td><td><div>${dateLabel(b.date)}</div><div class="sub">${timeLabel(b.time)} · ${safe(b.duration||'ساعة')}</div></td><td>${safe(b.service)}</td><td><div>${money(b.total)}</div><div class="sub">متبقي ${money(remaining(b))}</div></td><td><span class="pill ${safe(b.status)}">${labels[b.status]||'قيد التأكيد'}</span></td><td><div class="row-actions"><button class="icon-btn" title="عرض التفاصيل" data-action="view" data-id="${safe(b.id)}">⌕</button><button class="icon-btn" title="تعديل" data-action="edit" data-id="${safe(b.id)}">✎</button><button class="icon-btn" title="حذف" data-action="delete" data-id="${safe(b.id)}">×</button></div></td></tr>`).join('');$('emptyState').hidden=filtered.length>0;$('bookingCount').textContent=`${filtered.length} حجز`;
const today=todayISO(),active=bookings.filter(b=>b.status!=='cancelled'),upcoming=active.filter(b=>b.date>=today&&b.status!=='done');$('todayCount').textContent=active.filter(b=>b.date===today).length;$('upcomingCount').textContent=upcoming.length;$('revenueTotal').textContent=money(active.reduce((s,b)=>s+(Number(b.total)||0),0));$('remainingTotal').textContent=money(active.reduce((s,b)=>s+remaining(b),0));
const near=upcoming.sort((a,b)=>(a.date+a.time).localeCompare(b.date+b.time)).slice(0,4);$('upcomingList').innerHTML=near.length?near.map(b=>`<div class="quick-item"><div class="datebox"><b>${new Date(b.date+'T12:00:00').getDate()}</b><small>${new Intl.DateTimeFormat('ar-EG',{month:'short'}).format(new Date(b.date+'T12:00:00'))}</small></div><div class="quick-info"><strong>${safe(b.name)}</strong><span>${timeLabel(b.time)} · ${safe(b.service)}</span></div><span class="pill ${safe(b.status)}">${labels[b.status]}</span></div>`).join(''):'<div class="empty">لا توجد مواعيد قادمة حاليًا.</div>'}
function resetForm(){ $('bookingForm').reset();$('bookingId').value='';$('bookingDate').value=todayISO();$('bookingTime').value='17:00';$('deposit').value='0';$('bookingStatus').value='pending';$('formTitle').textContent='إضافة حجز جديد';$('saveBookingBtn').textContent='حفظ الحجز';updateRemaining() }
function updateRemaining(){const total=Number($('totalPrice').value)||0,dep=Number($('deposit').value)||0;$('remainingPreview').textContent=money(Math.max(0,total-dep))}
function formData(){return {name:$('clientName').value.trim(),phone:$('clientPhone').value.trim(),date:$('bookingDate').value,time:$('bookingTime').value,service:$('serviceType').value,duration:$('sessionDuration').value,status:$('bookingStatus').value,total:Math.max(0,Number($('totalPrice').value)||0),deposit:Math.max(0,Number($('deposit').value)||0),notes:$('bookingNotes').value.trim()}}
$('bookingForm').addEventListener('submit',e=>{e.preventDefault();const data=formData();if(data.deposit>data.total){showToast('العربون أكبر من السعر الإجمالي. راجع المبلغين.');return}const id=$('bookingId').value;if(id){const i=bookings.findIndex(b=>b.id===id);if(i>=0)bookings[i]={...bookings[i],...data}}else{bookings.push({id:Date.now().toString(36)+Math.random().toString(36).slice(2,7),...data,createdAt:new Date().toISOString()})}persist();render();resetForm();showToast(id?'تم تحديث الحجز':'تم حفظ الحجز بنجاح')});
function editBooking(id){const b=bookings.find(x=>x.id===id);if(!b)return;$('bookingId').value=b.id;$('clientName').value=b.name;$('clientPhone').value=b.phone;$('bookingDate').value=b.date;$('bookingTime').value=b.time;$('serviceType').value=b.service;$('sessionDuration').value=b.duration||'ساعة';$('bookingStatus').value=b.status;$('totalPrice').value=b.total;$('deposit').value=b.deposit;$('bookingNotes').value=b.notes||'';$('formTitle').textContent='تعديل بيانات الحجز';$('saveBookingBtn').textContent='حفظ التعديلات';updateRemaining();$('bookingFormPanel').scrollIntoView({behavior:'smooth',block:'start'})}
function viewBooking(id){const b=bookings.find(x=>x.id===id);if(!b)return;$('modalContent').innerHTML=`<div class="form-grid"><div><label>اسم العميل</label><p><b>${safe(b.name)}</b></p></div><div><label>رقم الهاتف</label><p>${safe(b.phone)}</p></div><div><label>تاريخ الجلسة</label><p>${dateLabel(b.date)}</p></div><div><label>الوقت والمدة</label><p>${timeLabel(b.time)} · ${safe(b.duration||'ساعة')}</p></div><div class="span2"><label>الخدمة</label><p>${safe(b.service)}</p></div><div><label>السعر الإجمالي</label><p><b>${money(b.total)}</b></p></div><div><label>العربون</label><p>${money(b.deposit)}</p></div><div class="span2"><label>المبلغ المتبقي</label><p><b>${money(remaining(b))}</b></p></div><div class="span2"><label>الحالة</label><p><span class="pill ${safe(b.status)}">${labels[b.status]}</span></p></div><div class="span2"><label>ملاحظات</label><p>${safe(b.notes||'لا توجد ملاحظات')}</p></div></div><div class="form-actions"><button class="btn btn-primary" id="modalEdit">تعديل الحجز</button><button class="btn btn-light" id="modalClose2">إغلاق</button></div>`;$('detailModal').classList.add('show');$('modalEdit').onclick=()=>{$('detailModal').classList.remove('show');editBooking(id)};$('modalClose2').onclick=()=>$('detailModal').classList.remove('show')}
$('bookingsBody').addEventListener('click',e=>{const btn=e.target.closest('button[data-action]');if(!btn)return;const {action,id}=btn.dataset;if(action==='view')viewBooking(id);if(action==='edit')editBooking(id);if(action==='delete'){const b=bookings.find(x=>x.id===id);if(b&&confirm(`هل تريد حذف حجز ${b.name}؟ لا يمكن التراجع عن الحذف.`)){bookings=bookings.filter(x=>x.id!==id);persist();render();showToast('تم حذف الحجز')}}});
$('newBookingBtn').addEventListener('click',()=>{resetForm();$('bookingFormPanel').scrollIntoView({behavior:'smooth',block:'start'});$('clientName').focus()});$('resetFormBtn').addEventListener('click',resetForm);['totalPrice','deposit'].forEach(id=>$(id).addEventListener('input',updateRemaining));['searchInput','statusFilter','dateFilter'].forEach(id=>$(id).addEventListener(id==='searchInput'?'input':'change',render));$('closeModal').onclick=()=>$('detailModal').classList.remove('show');$('detailModal').addEventListener('click',e=>{if(e.target===$('detailModal'))$('detailModal').classList.remove('show')});
$('enterApp').addEventListener('click',()=>{ $('splash').classList.add('hide'); try{sessionStorage.setItem('asraa_entered','1')}catch(e){} });if('serviceWorker' in navigator && location.protocol.startsWith('http')){window.addEventListener('load',()=>navigator.serviceWorker.register('./sw.js').catch(()=>{}))};try{if(sessionStorage.getItem('asraa_entered')==='1')$('splash').classList.add('hide')}catch(e){};
$('todayLabel').textContent=new Intl.DateTimeFormat('ar-EG',{weekday:'long',day:'numeric',month:'long',year:'numeric'}).format(new Date());load();$('bookingDate').value=todayISO();render();
</script></body></html>
